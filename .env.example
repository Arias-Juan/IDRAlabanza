# Copiar a .env para desarrollo local (el .env NO se sube al repo).

# Proyecto GCP. Si se omite, se usa el del ADC / de la service account.
PROJECT_ID=asistente-personal-unico

TABLE_ID=asistente-personal-unico.alabanza.canciones
SETLIST_TABLE_ID=asistente-personal-unico.alabanza.set_lista

# Días que dura publicado un listado.
SETLIST_TTL_DAYS=7

# Caché en proceso, en segundos.
SONGS_CACHE_TTL=600
SETLIST_CACHE_TTL=60

# Coma-separadas. Sin ninguna, los endpoints de escritura devuelven 503.
API_KEYS=cambiame-por-una-key-larga
